-  LBFGSpp::LBFGSParam<float> param;
+  // Joint limits: box constraints of the solve (L-BFGS-B). Unbounded by default.
+  Eigen::VectorX<float> lower_bounds_ = Eigen::VectorX<float>::Constant(
+      FAST_FK_NUMBER_OF_JOINTS, -std::numeric_limits<float>::infinity());
+  Eigen::VectorX<float> upper_bounds_ = Eigen::VectorX<float>::Constant(
+      FAST_FK_NUMBER_OF_JOINTS, std::numeric_limits<float>::infinity());
+  std::unique_ptr<LBFGSpp::LBFGSBSolver<float>> solver;
+  LBFGSpp::LBFGSBParam<float> param;
 
   InverseKinematics(const Eigen::Matrix<float, 3, 3>& target_rot,
                     const Eigen::Vector<float, 3>& target_pose)
@@ -29,7 +36,19 @@
     param.epsilon_rel = 1E-3;
     param.max_iterations = 30;
 
-    solver = std::make_unique<LBFGSpp::LBFGSSolver<float>>(param);
+    solver = std::make_unique<LBFGSpp::LBFGSBSolver<float>>(param);
+  }
+
+  // Joint i stays within [lower[i], upper[i]] (use +-infinity for no limit).
+  void set_joint_limits(const Eigen::VectorX<float>& lower, const Eigen::VectorX<float>& upper)
+  {
+    if(lower.size() != FAST_FK_NUMBER_OF_JOINTS || upper.size() != FAST_FK_NUMBER_OF_JOINTS ||
+       (lower.array() > upper.array()).any())
+    {
+      throw std::invalid_argument("joint limits need FAST_FK_NUMBER_OF_JOINTS entries with lower <= upper");
+    }
+    lower_bounds_ = lower;
+    upper_bounds_ = upper;
   }
 
   fk_interface::IKSolverStats inverse_kinematics(Eigen::Matrix<float, 4, 4>& transform,
@@ -41,11 +60,12 @@
     target_pose_(2) = transform(2, 3);
 
     float fx = 1E10;
-    int niter;
+    int niter = 0;
 
     try
     {
-      niter = solver->minimize(*this, q_guess, fx);
+      // Starts from q_guess projected onto the limits.
+      niter = solver->minimize(*this, q_guess, fx, lower_bounds_, upper_bounds_);
     }
     catch(const std::runtime_error& e)
     {
