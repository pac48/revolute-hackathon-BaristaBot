+
+namespace
+{
+shared_can_interface::v1::DeviceConfiguration limited_gripper_configuration()
+{
+  auto device = metric_gripper_configuration();
+  device.parameters["max_torque"] = "0.5";  // kp 50: the command is held 0.01 rad ahead of a blocked motor
+  return device;
+}
+}  // namespace
+
+TEST(RebotGripperProtocol, MaxTorqueHoldsTheCommandCloseToABlockedMotor)
+{
+  rebot_robstride_protocol::RebotGripperProtocol protocol;
+  protocol.configure({{"host_id", "0xFD"}}, {limited_gripper_configuration()});
+  ASSERT_TRUE(protocol.process_frame(status(2.5F, 0.0F), std::chrono::steady_clock::now()));
+  ASSERT_TRUE(protocol.set_command("gripper_command_joint", "velocity", 0.1));
+  ASSERT_TRUE(protocol.set_command("gripper_command_joint", "position", 0.0));  // close on something at 2.5 rad
+
+  std::vector<shared_can_interface::v1::CanFrame> commands;
+  for (int i = 0; i < 20; ++i) {  // 300 ms: the motor stays at 2.5 rad, stalled behind its target
+    protocol.command_frames(commands);
+    std::this_thread::sleep_for(std::chrono::milliseconds(15));
+    ASSERT_TRUE(protocol.process_frame(status(2.5F, 0.0F), std::chrono::steady_clock::now()));
+  }
+  protocol.command_frames(commands);
+  ASSERT_EQ(commands.size(), 1U);
+  // 0.5 N*m / kp 50 = 0.01 rad ahead of the motor, not at the closed end (0 rad), and no velocity push.
+  EXPECT_NEAR(command_position(commands.front()), 2.49, 0.003);
+  EXPECT_NEAR(command_velocity(commands.front()), 0.0, 0.1);
+}
+
+TEST(RebotGripperProtocol, MaxTorqueDoesNotLimitFreeMotion)
+{
+  rebot_robstride_protocol::RebotGripperProtocol protocol;
+  protocol.configure({{"host_id", "0xFD"}}, {limited_gripper_configuration()});
+  ASSERT_TRUE(protocol.process_frame(status(5.0F, 0.0F), std::chrono::steady_clock::now()));
+  ASSERT_TRUE(protocol.set_command("gripper_command_joint", "velocity", 0.025));  // 0.5 stroke/s = 2.5 rad/s
+  ASSERT_TRUE(protocol.set_command("gripper_command_joint", "position", 0.0));
+
+  std::vector<shared_can_interface::v1::CanFrame> commands;
+  double position = 5.0;
+  for (int i = 0; i < 20; ++i) {  // the motor follows the command, moving toward the target at the slew speed
+    protocol.command_frames(commands);
+    position = command_position(commands.front());
+    std::this_thread::sleep_for(std::chrono::milliseconds(15));
+    ASSERT_TRUE(protocol.process_frame(
+        status(static_cast<float>(position), -2.5F), std::chrono::steady_clock::now()));
+  }
+  EXPECT_LT(position, 4.5);  // ~0.75 rad of slewing; held at 0.01 rad ahead it would have moved 0.2 rad
+}
+
+TEST(RebotGripperProtocol, MaxTorqueMustBeNonNegative)
+{
+  rebot_robstride_protocol::RebotGripperProtocol protocol;
+  auto device = metric_gripper_configuration();
+  device.parameters["max_torque"] = "-1";
+  EXPECT_THROW(protocol.configure({{"host_id", "0xFD"}}, {device}), std::invalid_argument);
+}
