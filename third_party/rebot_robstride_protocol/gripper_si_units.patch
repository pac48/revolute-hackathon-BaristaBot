+double RebotGripperProtocol::unit_scale(const Device & device)
+{
+  return device.stroke > 0.0 ? -device.stroke : 1.0;
+}
+
+double RebotGripperProtocol::joint_position(const Device & device, double closure) const
+{
+  return device.stroke > 0.0 ? device.stroke * (1.0 - closure) : closure;
+}
+
+// The largest position and velocity (per second) of the joint: 1, or the stroke in m.
+double RebotGripperProtocol::joint_limit(const Device & device) const
+{
+  return device.stroke > 0.0 ? device.stroke : 1.0;
+}
