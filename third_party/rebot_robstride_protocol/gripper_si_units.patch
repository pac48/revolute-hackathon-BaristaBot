+namespace
+{
+shared_can_interface::v1::DeviceConfiguration metric_gripper_configuration()
+{
+  auto device = gripper_configuration();
+  device.parameters["stroke"] = "0.05";
+  device.parameters.erase("default_velocity");
+  return device;
+}
+}  // namespace
+
+TEST(RebotGripperProtocol, StrokeGivesPositionInMetersClosedAtZero)
+{
+  rebot_robstride_protocol::RebotGripperProtocol protocol;
+  protocol.configure({{"host_id", "0xFD"}}, {metric_gripper_configuration()});
+
+  double value = -1.0;
+  ASSERT_TRUE(protocol.process_frame(status(5.0F), std::chrono::steady_clock::now()));
+  ASSERT_TRUE(protocol.get_state("gripper_command_joint", "position", value));
+  EXPECT_NEAR(value, 0.05, 1e-5);  // open
+  ASSERT_TRUE(protocol.process_frame(status(2.5F), std::chrono::steady_clock::now()));
+  ASSERT_TRUE(protocol.get_state("gripper_command_joint", "position", value));
+  EXPECT_NEAR(value, 0.025, 1e-5);
+  ASSERT_TRUE(protocol.process_frame(status(0.0F), std::chrono::steady_clock::now()));
+  ASSERT_TRUE(protocol.get_state("gripper_command_joint", "position", value));
+  EXPECT_NEAR(value, 0.0, 1e-5);  // closed
+}
+
+TEST(RebotGripperProtocol, StrokeVelocityAndEffortAreSi)
+{
+  rebot_robstride_protocol::RebotGripperProtocol protocol;
+  protocol.configure({{"host_id", "0xFD"}}, {metric_gripper_configuration()});
+  // Opening at 1 rad/s of the motor (span 5 rad = 0.05 m) is 0.01 m/s.
+  ASSERT_TRUE(protocol.process_frame(status(2.5F, 1.0F), std::chrono::steady_clock::now()));
+  double value = 0.0;
+  ASSERT_TRUE(protocol.get_state("gripper_command_joint", "velocity", value));
+  EXPECT_NEAR(value, 0.01, 1e-3);
+  // Default speed: a quarter of the stroke per second.
+  const auto now = std::chrono::steady_clock::now();
+  ASSERT_TRUE(protocol.process_frame(parameter_reply(0x7019, 2.5F), now));
+  ASSERT_TRUE(protocol.process_frame(parameter_reply(0x7005, 0.0F), now));
+  ASSERT_TRUE(protocol.process_frame(parameter_reply(0x701A, 0.0F), now));
+  ASSERT_TRUE(protocol.get_initial_command("gripper_command_joint", "velocity", value));
+  EXPECT_NEAR(value, 0.0125, 1e-9);
+  ASSERT_TRUE(protocol.get_initial_command("gripper_command_joint", "position", value));
+  EXPECT_NEAR(value, 0.025, 1e-5);
+}
+
+TEST(RebotGripperProtocol, StrokeCommandsAreInMetersAndSlewedInMetersPerSecond)
+{
+  rebot_robstride_protocol::RebotGripperProtocol protocol;
+  protocol.configure({{"host_id", "0xFD"}}, {metric_gripper_configuration()});
+  ASSERT_TRUE(protocol.process_frame(status(5.0F), std::chrono::steady_clock::now()));  // open
+  EXPECT_FALSE(protocol.set_command("gripper_command_joint", "position", 0.06));
+  EXPECT_FALSE(protocol.set_command("gripper_command_joint", "position", -0.01));
+  EXPECT_FALSE(protocol.set_command("gripper_command_joint", "velocity", 0.06));
+  ASSERT_TRUE(protocol.set_command("gripper_command_joint", "velocity", 0.025));  // half the stroke per s
+  ASSERT_TRUE(protocol.set_command("gripper_command_joint", "position", 0.0));    // close
+
+  std::vector<shared_can_interface::v1::CanFrame> commands;
+  protocol.command_frames(commands);
+  ASSERT_EQ(commands.size(), 1U);
+  EXPECT_NEAR(command_position(commands.front()), 5.0, 4e-4);
+  std::this_thread::sleep_for(std::chrono::milliseconds(20));
+  protocol.command_frames(commands);
+  ASSERT_EQ(commands.size(), 1U);
+  const double motor_target = command_position(commands.front());
+  EXPECT_LT(motor_target, 5.0);  // closing: toward the closed position, at ~0.5 stroke/s
+  EXPECT_GT(motor_target, 4.85);
+}
