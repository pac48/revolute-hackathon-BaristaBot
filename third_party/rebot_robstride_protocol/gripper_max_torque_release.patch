+TEST(RebotGripperProtocol, MaxTorqueReleasesAtOnceWhenTheTargetReverses)
+{
+  rebot_robstride_protocol::RebotGripperProtocol protocol;
+  protocol.configure({{"host_id", "0xFD"}}, {limited_gripper_configuration()});
+  ASSERT_TRUE(protocol.process_frame(status(2.5F, 0.0F), std::chrono::steady_clock::now()));
+  ASSERT_TRUE(protocol.set_command("gripper_command_joint", "velocity", 0.1));
+  ASSERT_TRUE(protocol.set_command("gripper_command_joint", "position", 0.0));
+  std::vector<shared_can_interface::v1::CanFrame> commands;
+  for (int i = 0; i < 20; ++i) {  // squeezed: held 0.01 rad ahead
+    protocol.command_frames(commands);
+    std::this_thread::sleep_for(std::chrono::milliseconds(15));
+    ASSERT_TRUE(protocol.process_frame(status(2.5F, 0.0F), std::chrono::steady_clock::now()));
+  }
+  // Open: the command goes ahead of the (still blocked) motor by the slew, with the full torque of the law to
+  // break away, not another 0.01 rad (a squeeze limit under the gripper's friction would never let it move).
+  ASSERT_TRUE(protocol.set_command("gripper_command_joint", "position", 0.05));
+  std::this_thread::sleep_for(std::chrono::milliseconds(15));
+  protocol.command_frames(commands);
+  EXPECT_GT(command_position(commands.front()), 2.5 + 0.05);
+}
