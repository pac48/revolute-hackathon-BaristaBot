# @cppad: CppAD (https://github.com/coin-or/CppAD), automatic differentiation.
# include/cppad/configure.hpp is generated here with the values CppAD's CMake
# picks on Linux x86_64 (no ADOL-C/ColPack/Ipopt, CppAD vectors).
# License: EPL-2.0 or GPL-2.0-or-later

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

CONFIGURE = {
    "compiler_has_conversion_warn": "1",
    "cppad_debug_and_release_01": "1",
    "use_cplusplus_2017_ok": "1",
    "cppad_version": "20250000.3",
    "cppad_has_adolc": "0",
    "cppad_has_colpack": "0",
    "cppad_has_eigen": "0",
    "cppad_has_ipopt": "0",
    "cppad_deprecated_01": "0",
    "cppad_boostvector": "0",
    "cppad_cppadvector": "1",
    "cppad_stdvector": "0",
    "cppad_eigenvector": "0",
    "cppad_has_gettimeofday": "1",
    "cppad_tape_addr_type": "unsigned int",
    "cppad_is_same_tape_addr_type_size_t": "0",
    "cppad_tape_id_type": "unsigned int",
    "cppad_max_num_threads": "48",
    "cppad_has_mkstemp": "1",
    "cppad_has_tmpnam_s": "0",
    "cppad_c_compiler_cmd": "gcc",
    "cppad_c_compiler_gnu_flags": "1",
    "cppad_c_compiler_msvc_flags": "0",
    "cppad_is_same_unsigned_int_size_t": "0",
    "cppad_padding_block_t": "",
}

genrule(
    name = "configure_hpp",
    srcs = ["include/cppad/configure.hpp.in"],
    outs = ["include/cppad/configure.hpp"],
    # Fails if a @variable@ is left unset (e.g. after a CppAD update).
    cmd = "sed " + " ".join(["-e 's|@%s@|%s|g'" % (k, v) for k, v in CONFIGURE.items()]) +
          " $< > $@ && ! grep -n '@[a-z0-9_]*@' $@",
)

cc_library(
    name = "cppad",
    # code_gen_fun.cpp needs CppADCodeGen (CMake builds it only when found); cricket doesn't use it.
    srcs = glob(
        ["cppad_lib/*.cpp"],
        exclude = ["cppad_lib/code_gen_fun.cpp"],
    ),
    hdrs = glob(["include/cppad/**/*.hpp"]) + [":configure_hpp"],
    copts = ["-w"],
    includes = ["include"],
    linkopts = ["-ldl"],
)
