# @cgal: CGAL (https://www.cgal.org), header-only library release. Built
# without GMP/MPFR: exact arithmetic falls back to Boost.Multiprecision.
# License: GPL-3.0-or-later / LGPL-3.0-or-later (per package)

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "cgal",
    hdrs = glob(["include/CGAL/**"]),
    defines = ["CGAL_DISABLE_GMP=1"],
    includes = ["include"],
    # Boost libraries CGAL's headers use (rosdistro's aliases of the BCR boost.* modules).
    deps = ["@boost.multiprecision"] + ["@rosdistro//cc:boost." + lib for lib in [
        "any",
        "config",
        "container",
        "iterator",
        "math",
        "mpl",
        "optional",
        "random",
        "range",
        "tuple",
        "unordered",
        "utility",
        "variant",
    ]],
)
