# @cppadcg: CppADCodeGen (https://github.com/joaoleal/CppADCodeGen), source code
# generation from CppAD tapes. Header-only; configure.hpp is generated here.
# cricket's CppADCodeGen.patch only trims the CMake build, so it isn't needed.
# License: EPL-1.0 or GPL-3.0

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "configure_hpp",
    srcs = ["include/cppad/cg/configure.hpp.in"],
    outs = ["include/cppad/cg/configure.hpp"],
    cmd = "sed -e 's|@cppadcg_version@|2.5.0|g' $< > $@ && ! grep -n '@[a-z0-9_]*@' $@",
)

# CMake's textfile2h: embed the thread pool / OpenMP C sources (written into
# generated model libraries) as raw string constants.
THREADPOOL_SOURCES = {
    "pthread_pool.c": "CPPADCG_PTHREAD_POOL_C_FILE",
    "pthread_pool.h": "CPPADCG_PTHREAD_POOL_H_FILE",
    "openmp.c": "CPPADCG_OPENMP_C_FILE",
    "openmp.h": "CPPADCG_OPENMP_H_FILE",
}

[
    genrule(
        name = "threadpool_" + src.replace(".", "_"),
        srcs = ["include/cppad/cg/model/threadpool/" + src],
        outs = ["include/cppad/cg/model/threadpool/%s.hpp" % src.replace(".", "_")],
        cmd = ("(printf 'const char %s[] = R\"*=*('; cat $<; " +
               "printf ')*=*\";\\n\\nconst size_t %s_SIZE = %%s;\\n\\n' $$(wc -c < $<)) > $@") % (var, var),
    )
    for src, var in THREADPOOL_SOURCES.items()
]

cc_library(
    name = "cppadcg",
    hdrs = glob(["include/cppad/**/*.hpp"]) + [":configure_hpp"] + [
        ":threadpool_" + src.replace(".", "_")
        for src in THREADPOOL_SOURCES
    ],
    includes = ["include"],
    deps = ["@cppad"],
)
