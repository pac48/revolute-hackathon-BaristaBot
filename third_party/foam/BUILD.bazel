# BUILD files for foam (https://github.com/CoMMALab/foam), the spherization tool,
# and the mesh tools it runs (ManifoldPlus, Manifold, Fast-Quadric-Mesh-
# Simplification, libigl); the repos are http_archives in MODULE.bazel. foam's
# Python dependencies are the @pip_foam hub (requirements.in -> requirements_lock.txt,
# regenerate with `bazel run //third_party/foam:requirements.update`).

load("@rules_python//python:pip.bzl", "compile_pip_requirements")

exports_files(glob(
    [
        "*.BUILD.bazel",
        "*.patch",
    ],
    allow_empty = True,
))

compile_pip_requirements(
    name = "requirements",
    src = "requirements.in",
    requirements_txt = "requirements_lock.txt",
)
