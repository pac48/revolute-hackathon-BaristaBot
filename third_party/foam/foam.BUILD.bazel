# @foam: foam (https://github.com/CoMMALab/foam), spherical approximation of
# robot meshes. Builds SphereTree's makeTree* tools (vendored in external/spheretree)
# and the Python package; the mesh tools it also runs come from @manifoldplus,
# @manifold_old and @fqms. Patched (//third_party/foam:binary_paths.patch) to find
# the tools through FOAM_BINARY_<name> environment variables.
# License: MIT (foam); SphereTree: see external/spheretree/COPYRIGHT.txt

load("@pip_foam//:requirements.bzl", "requirement")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE.txt", "external/spheretree/COPYRIGHT.txt"])

# Old C/C++ (pre-C++17, e.g. `register`), built quietly with its original standard.
# //third_party/foam:spheretree_minmax.patch fixes a std::max/min vs. macro clash.
cc_library(
    name = "spheretree",
    srcs = [
        "external/spheretree/src/API/DomainSampler.cpp",
        "external/spheretree/src/API/Hybrid.cpp",
        "external/spheretree/src/API/MergeHubbard.cpp",
        "external/spheretree/src/API/MSBase.cpp",
        "external/spheretree/src/API/MSGrid.cpp",
        "external/spheretree/src/API/MSRelaxation.cpp",
        "external/spheretree/src/API/REBase.cpp",
        "external/spheretree/src/API/REDiscard.cpp",
        "external/spheretree/src/API/RELargest.cpp",
        "external/spheretree/src/API/RELargestLM.cpp",
        "external/spheretree/src/API/REMaxElim.cpp",
        "external/spheretree/src/API/RESelect.cpp",
        "external/spheretree/src/API/SEConvex.cpp",
        "external/spheretree/src/API/SEPoint.cpp",
        "external/spheretree/src/API/SESphPt.cpp",
        "external/spheretree/src/API/SFBase.cpp",
        "external/spheretree/src/API/SFMinErr.cpp",
        "external/spheretree/src/API/SFRitter.cpp",
        "external/spheretree/src/API/SFWhite/ball.cpp",
        "external/spheretree/src/API/SFWhite/complex.c",
        "external/spheretree/src/API/SFWhite.cpp",
        "external/spheretree/src/API/SFWhite/nrutil.c",
        "external/spheretree/src/API/SFWhite/svd.cpp",
        "external/spheretree/src/API/SOBalance.cpp",
        "external/spheretree/src/API/SOBase.cpp",
        "external/spheretree/src/API/SOPerSphere.cpp",
        "external/spheretree/src/API/SOSimplex.cpp",
        "external/spheretree/src/API/SRBurst.cpp",
        "external/spheretree/src/API/SRComposite.cpp",
        "external/spheretree/src/API/SRExpand.cpp",
        "external/spheretree/src/API/SRGrid.cpp",
        "external/spheretree/src/API/SRMerge.cpp",
        "external/spheretree/src/API/SRQuickBurst.cpp",
        "external/spheretree/src/API/SRSpawn.cpp",
        "external/spheretree/src/API/SRStandOff.cpp",
        "external/spheretree/src/API/SRVoronoi.cpp",
        "external/spheretree/src/API/SSIsohedron.cpp",
        "external/spheretree/src/API/SSRings.cpp",
        "external/spheretree/src/API/STGGeneric.cpp",
        "external/spheretree/src/API/STGHubbard.cpp",
        "external/spheretree/src/API/STGOctree.cpp",
        "external/spheretree/src/API/SurfaceDiv.cpp",
        "external/spheretree/src/API/VFAdaptive.cpp",
        "external/spheretree/src/API/VFGapCross.cpp",
        "external/spheretree/src/Base/ProcMon.cpp",
        "external/spheretree/src/BBox/BBox.cpp",
        "external/spheretree/src/BBox/eigen.cpp",
        "external/spheretree/src/BBox/MVBB/gdiam.cpp",
        "external/spheretree/src/BBox/qHull/geom2.cpp",
        "external/spheretree/src/BBox/qHull/geom.cpp",
        "external/spheretree/src/BBox/qHull/global.cpp",
        "external/spheretree/src/BBox/qHull/mem.cpp",
        "external/spheretree/src/BBox/qHull/merge.cpp",
        "external/spheretree/src/BBox/qHull/poly2.cpp",
        "external/spheretree/src/BBox/qHull/poly.cpp",
        "external/spheretree/src/BBox/qHull/qhull.cpp",
        "external/spheretree/src/BBox/qHull/set.cpp",
        "external/spheretree/src/BBox/qHull/stat.cpp",
        "external/spheretree/src/BBox/qHull/user.cpp",
        "external/spheretree/src/DecodeParam.cpp",
        "external/spheretree/src/EvalTree.cpp",
        "external/spheretree/src/Exceptions/ErrorLog.cpp",
        "external/spheretree/src/Exceptions/Exception.cpp",
        "external/spheretree/src/Exceptions/MemoryException.cpp",
        "external/spheretree/src/Export/POV.cpp",
        "external/spheretree/src/Export/VRML.cpp",
        "external/spheretree/src/Geometry/Circle.cpp",
        "external/spheretree/src/Geometry/CubeTri.cpp",
        "external/spheretree/src/Geometry/Line2D.cpp",
        "external/spheretree/src/Geometry/LineSeg.cpp",
        "external/spheretree/src/Geometry/pcube/fpcube.cpp",
        "external/spheretree/src/Geometry/pcube/pcube.cpp",
        "external/spheretree/src/Geometry/Plane.cpp",
        "external/spheretree/src/Geometry/Point2D.cpp",
        "external/spheretree/src/Geometry/Point3D.cpp",
        "external/spheretree/src/Geometry/RayBox.c",
        "external/spheretree/src/Geometry/Ray.cpp",
        "external/spheretree/src/Geometry/Sphere.cpp",
        "external/spheretree/src/Geometry/Transform2D.cpp",
        "external/spheretree/src/Geometry/Transform3D.cpp",
        "external/spheretree/src/Geometry/TriTri.cpp",
        "external/spheretree/src/Geometry/Vector2D.cpp",
        "external/spheretree/src/Geometry/Vector3D.cpp",
        "external/spheretree/src/LinearAlgebra/Matrix.cpp",
        "external/spheretree/src/MedialAxis/Clusters.cpp",
        "external/spheretree/src/MedialAxis/MedialTester.cpp",
        "external/spheretree/src/MedialAxis/Voronoi3D.cpp",
        "external/spheretree/src/MedialAxis/VoronoiFace.cpp",
        "external/spheretree/src/MinMax/Simplex.cpp",
        "external/spheretree/src/SphereTree/SphereTree.cpp",
        "external/spheretree/src/Surface/Internal.cpp",
        "external/spheretree/src/Surface/InternalGem.cpp",
        "external/spheretree/src/Surface/OBJLoader.cpp",
        "external/spheretree/src/Surface/SpacialHash.cpp",
        "external/spheretree/src/Surface/Surface.cpp",
        "external/spheretree/src/Surface/SurfaceRep.cpp",
        "external/spheretree/src/Surface/SurfaceTester.cpp",
        "external/spheretree/src/Surface/VolInt.cpp",
        "external/spheretree/src/Surface/Voxel.cpp",
        "external/spheretree/src/VerifyModel.cpp",
    ] + glob(["external/spheretree/src/**/*.h"]),
    copts = [
        "-w",
        "-O3",  # spherization is slow; optimize even in fastbuild
    ],
    cxxopts = ["-std=c++11"],
    linkopts = ["-lm"],
    # svd.cpp includes nrutil.c.
    textual_hdrs = ["external/spheretree/src/API/SFWhite/nrutil.c"],
)

[
    cc_binary(
        name = tool,
        srcs = ["external/spheretree/src/%s.cpp" % tool],
        copts = [
        "-w",
        "-O3",  # spherization is slow; optimize even in fastbuild
    ],
        cxxopts = ["-std=c++11"],
        deps = [":spheretree"],
    )
    for tool in ['makeTreeGrid', 'makeTreeHubbard', 'makeTreeMedial', 'makeTreeOctree', 'makeTreeSpawn']
]

py_library(
    name = "foam",
    srcs = glob(["foam/**/*.py"]),
    imports = ["."],
    deps = [
        requirement("numpy"),
        requirement("scipy"),
        requirement("trimesh"),
        requirement("vhacdx"),
        requirement("xmltodict"),
    ],
)
