# @libigl: libigl (https://github.com/libigl/libigl) in header-only mode (its
# .cpp files are included by the headers), at the commit ManifoldPlus pins.
# License: MPL-2.0

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "libigl",
    hdrs = glob(["include/igl/*.h"]),
    includes = ["include"],
    textual_hdrs = glob([
        "include/igl/*.cpp",
        "include/igl/*.c",  # e.g. raytri.c, included by ray_mesh_intersect.cpp
    ]),
    deps = ["@eigen"],
)
