# @manifold_old: Manifold (https://github.com/hjwdzh/Manifold), the older
# watertight conversion foam uses by default (`manifold_old`), and its mesh
# simplifier (`simplify_old`). As in foam's CMake, Eigen and libigl come from
# ManifoldPlus's versions (@eigen, @libigl; the vendored 3rd/Eigen doesn't build
# with current clang); only glm is taken from 3rd/.
# License: MIT

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "glm",
    hdrs = glob(["3rd/glm/**/*.hpp"]),
    strip_include_prefix = "3rd",
    textual_hdrs = glob(["3rd/glm/**/*.inl"]),
)

cc_binary(
    name = "manifold_old",
    srcs = [
        "src/BVH.cpp",
        "src/Intersection.cpp",
        "src/main.cpp",
        "src/Model_OBJ.cpp",
    ] + glob(["src/*.h"]),
    copts = [
        "-w",
        "-O3",  # spherization is slow; optimize even in fastbuild
    ],
    cxxopts = ["-std=c++14"],  # @eigen needs C++14
    linkopts = ["-lpthread"],
    deps = [
        ":glm",
        "@eigen",
        "@libigl",
    ],
)

cc_binary(
    name = "simplify_old",
    srcs = ["src/simplify.cpp"] + glob(["src/*.h"]),
    copts = [
        "-w",
        "-O3",  # spherization is slow; optimize even in fastbuild
    ],
    cxxopts = ["-std=c++14"],  # @eigen needs C++14
    deps = [
        ":glm",
        "@eigen",
        "@libigl",
    ],
)
