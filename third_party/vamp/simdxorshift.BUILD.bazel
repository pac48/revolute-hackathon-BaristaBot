# @simdxorshift: AVX2 xorshift128+ random numbers, used by VAMP on x86.

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# License: Apache-2.0

cc_library(
    name = "simdxorshift",
    srcs = [
        "src/simdxorshift128plus.c",
        "src/xorshift128plus.c",
    ],
    hdrs = glob(["include/*.h"]),
    copts = [
        "-mavx2",
        "-w",
    ],
    includes = ["include"],
)
