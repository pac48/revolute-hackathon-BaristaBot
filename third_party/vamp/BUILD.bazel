# BUILD files and Starlark for VAMP (https://github.com/kavrakilab/vamp) and the
# dependencies its CMake build fetches; the repos are http_archives in MODULE.bazel.

load("@rules_cc//cc:defs.bzl", "cc_test")
load(":defs.bzl", "VAMP_COPTS", "vamp_robot")

exports_files(glob(["*.BUILD.bazel"]))

# VAMP's C++ RRT-Connect example on its built-in Panda: checks the library builds and plans.
cc_test(
    name = "rrtc_example_test",
    size = "small",
    srcs = ["@vamp//:rrtc_example"],
    copts = VAMP_COPTS + [
        "-Wno-c++11-narrowing",
        "-Wno-sign-compare",
    ],
    deps = ["@vamp//:builtin_robots"],
)

# The same example against a Panda generated by our codegen rule (from cricket's
# Panda URDF/SRDF) instead of VAMP's checked-in header: tests vamp_robot.
vamp_robot(
    name = "panda_generated",
    end_effector = "panda_grasptarget",
    module = "panda",
    srdf = "@cricket//:resources/panda/panda.srdf",
    struct_name = "Panda",
    urdf = "@cricket//:resources/panda/panda_spherized.urdf",
)

cc_test(
    name = "rrtc_example_generated_test",
    size = "small",
    srcs = ["@vamp//:rrtc_example"],
    copts = VAMP_COPTS + [
        "-Wno-c++11-narrowing",
        "-Wno-sign-compare",
    ],
    deps = [":panda_generated"],
)
