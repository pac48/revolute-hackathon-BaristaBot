# @vamp: VAMP's C++ planning library (header-only, src/impl/vamp). Bindings
# (Python, WebAssembly) are not built. Consumers need VAMP_COPTS from
# //third_party/vamp:defs.bzl.

load("@rules_cc//cc:defs.bzl", "cc_library")


package(default_visibility = ["//visibility:public"])

# License: Apache-2.0

exports_files(["LICENSE.txt"])

cc_library(
    name = "vamp",
    hdrs = glob(
        ["src/impl/vamp/**/*.hh"],
        exclude = [
            "src/impl/vamp/bindings/**",
            "src/impl/vamp/robots/**",
        ],
    ),
    includes = ["src/impl"],
    deps = [
        "@cddlib",
        "@eigen",
        "@nigh",
        "@pdqsort",
    ] + select({
        "@platforms//cpu:x86_64": ["@simdxorshift"],
        "//conditions:default": [],
    }),
)

# The robots VAMP ships (sphere, ur5, panda, fetch, baxter), generated by cricket.
cc_library(
    name = "builtin_robots",
    hdrs = glob(["src/impl/vamp/robots/*.hh"]),
    includes = ["src/impl"],
    deps = [":vamp"],
)

# VAMP's C++ RRT-Connect example (Panda), as a smoke test of the build.
filegroup(
    name = "rrtc_example",
    srcs = ["scripts/cpp/rrtc_example.cc"],
)
