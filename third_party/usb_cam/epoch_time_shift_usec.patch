Fix the wall-clock shift applied to V4L2 capture timestamps.

get_epoch_time_shift_us() divided timeval::tv_usec (already microseconds) by
1000, dropping almost all of the sub-second part of the current time. Every
image stamp was then too old by a constant 0-999 ms, depending on when the node
started (measured: ~540 ms, identical on the camera's machine and over the LAN).

--- a/include/usb_cam/utils.hpp
+++ b/include/usb_cam/utils.hpp
@@ -94,6 +94,6 @@
     monotonic_time.tv_sec * 1000000 + static_cast<int64_t>(
     std::round(monotonic_time.tv_nsec / 1000.0));
   const int64_t epoch_us =
-    epoch_time.tv_sec * 1000000 + epoch_time.tv_usec / 1000.0;
+    epoch_time.tv_sec * 1000000 + epoch_time.tv_usec;
 
   return static_cast<time_t>(epoch_us - uptime_us);
 }
