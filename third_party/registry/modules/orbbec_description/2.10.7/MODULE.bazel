# orbbec_description from orbbec/OrbbecSDK_ROS2 (v2-main); see third_party/registry/README.md.
module(
    name = "orbbec_description",
    version = "2.10.7",
    bazel_compatibility = [">=7.2.1"],
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_python", version = "2.4.5")

bazel_dep(name = "ament_cmake", version = "2.8.8-1.rcr.0")
bazel_dep(name = "ament_index_python", version = "1.13.3-3.rcr.2")
bazel_dep(name = "launch_ros", version = "0.29.9-1.rcr.0")
bazel_dep(name = "robot_state_publisher", version = "3.5.6-1.rcr.0")
bazel_dep(name = "rosdistro", version = "lyrical.2026-10-05.rcr.0")
bazel_dep(name = "rviz2", version = "15.2.6-1.rcr.0")
bazel_dep(name = "xacro", version = "2.1.1-3.rcr.3")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

pip_ros = use_extension("@rosdistro//python:defs.bzl", "pip_ros")
use_repo(pip_ros, "pip_ros")
