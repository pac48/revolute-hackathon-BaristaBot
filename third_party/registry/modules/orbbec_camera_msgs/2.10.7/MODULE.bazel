# orbbec_camera_msgs from orbbec/OrbbecSDK_ROS2 (v2-main); see third_party/registry/README.md.
module(
    name = "orbbec_camera_msgs",
    version = "2.10.7",
    bazel_compatibility = [">=7.2.1"],
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_python", version = "2.4.5")

bazel_dep(name = "action_msgs", version = "2.4.5-1.rcr.2")
bazel_dep(name = "ament_cmake", version = "2.8.8-1.rcr.0")
bazel_dep(name = "rosdistro", version = "lyrical.2026-10-05.rcr.0")
bazel_dep(name = "rosidl_default_generators", version = "1.8.1-3.rcr.4")
bazel_dep(name = "rosidl_default_runtime", version = "1.8.1-3.rcr.2")
bazel_dep(name = "sensor_msgs", version = "5.9.3-1.rcr.0")
bazel_dep(name = "std_msgs", version = "5.9.3-1.rcr.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

pip_ros = use_extension("@rosdistro//python:defs.bzl", "pip_ros")
use_repo(pip_ros, "pip_ros")
