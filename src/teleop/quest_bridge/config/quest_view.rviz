Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Headset view
      Max Value: 1
      Min Value: 0
      Median window: 5
      Normalize Range: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /quest/view/image_raw/compressed
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.1
      Plane Cell Count: 20
      Reference Frame: world
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: Robot
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF (arm links, teleop_target/command, quest_head/left/right)
      Show Names: true
      Show Arrows: false
      Marker Scale: 0.15
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Teleop target
      Shape: Axes
      Axes Length: 0.1
      Axes Radius: 0.008
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /teleop/target_pose
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.6
      Focal Point:
        X: 0.2
        Y: 0
        Z: 0.2
      Pitch: 0.45
      Yaw: 3.6
      Name: Current View
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1400
  Height: 800
