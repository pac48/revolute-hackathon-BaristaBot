# rebot_arm: functionality for the reBot Arm B601 robot model (C++: load_mujoco_model,
# make_kinematics; Python: description.robot_description for ros2_control), built on the
# model files in ../rebot_arm_data (fetched from Seeed-Projects/reBot-DevArm).

load("//src/robot_model/robot_model_utils:viewer.bzl", "model_viewer")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//src/robot_model/robot_model_utils:fast_kinematics.bzl", "fast_kinematics")
load("//src/robot_model/robot_model_utils:py_data_library.bzl", "py_data_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "rebot_arm",
    srcs = ["rebot_arm.cpp"],
    hdrs = ["rebot_arm.hpp"],
    data = ["//src/robot_model/rebot_arm_data:rs_arm_mjcf"],
    local_defines = [
        "REBOT_ARM_RS_MJCF=\\\"$(rlocationpath //src/robot_model/rebot_arm_data:rs_arm_mjcf)\\\"",
    ],
    deps = [
        ":rebot_arm_kinematics",
        "//src/robot_model/robot_model_utils:kdl_kinematics",
        "//src/robot_model/robot_model_utils:kinematics",
        "//src/robot_model/robot_model_utils:mujoco_model",
        "//src/robot_model/robot_model_utils:state_estimator",
        "//src/robot_model/robot_model_utils:renderer_api",
    ],
)

# rebot_arm::usd_path and make_renderer (renderer.hpp): link this to render. Separate from :rebot_arm
# because ovrtx and its runtime (1.4 GB, an NVIDIA RTX GPU to run) are a dependency only rendering needs.
cc_library(
    name = "rebot_arm_renderer",
    srcs = ["rebot_arm_renderer.cpp"],
    data = ["//src/robot_model/rebot_arm_data:scene_usd"],
    local_defines = [
        "REBOT_ARM_USD=\\\"$(rlocationpath //src/robot_model/rebot_arm_data:scene_usd)\\\"",
    ],
    deps = [
        ":rebot_arm",
        "//src/robot_model/robot_model_utils:mujoco_model",
        "//src/robot_model/robot_model_utils:renderer",
    ],
)

# The USD files correspond to the MJCF (no GPU needed).
cc_test(
    name = "rebot_arm_usd_test",
    size = "small",
    srcs = ["rebot_arm_usd_test.cpp"],
    args = [
        "$(rlocationpath //src/robot_model/rebot_arm_data:scene_usd)",
        "$(rlocationpath //src/robot_model/rebot_arm_data:rebot_arm_usd)",
        "$(rlocationpath //src/robot_model/rebot_arm_data:environment_usd)",
    ],
    data = [
        "//src/robot_model/rebot_arm_data:environment_usd",
        "//src/robot_model/rebot_arm_data:rebot_arm_usd",
        "//src/robot_model/rebot_arm_data:scene_usd",
    ],
    deps = [
        ":rebot_arm",
        "//src/robot_model/robot_model_utils:usd_correspondence",
        "@rosdistro//cc:googletest",
    ],
)

# Renders with ovrtx: needs an NVIDIA RTX GPU and its driver, outside any sandbox (the first run
# compiles shaders, minutes). Not in //... : bazel test //src/robot_model/rebot_arm:rebot_arm_render_test
cc_test(
    name = "rebot_arm_render_test",
    size = "large",
    srcs = ["rebot_arm_render_test.cpp"],
    tags = [
        "local",
        "manual",
        "requires-gpu",
    ],
    deps = [
        ":rebot_arm_renderer",
        "@rosdistro//cc:googletest",
    ],
)

cc_test(
    name = "rebot_arm_test",
    size = "small",
    srcs = ["rebot_arm_test.cpp"],
    deps = [
        ":rebot_arm",
        "@rosdistro//cc:googletest",
    ],
)

# Position PID gains for the torque (<motor>) actuators; mujoco_ros2_control
# needs them to accept position commands.
py_data_library(
    name = "pids",
    src = "pids.yaml",
)

# Python: robot_description() for ros2_control (URDF + mujoco_ros2_control block), and
# real_robot_description() (URDF + the real arm's shared_can_ros2 block).
py_library(
    name = "description",
    srcs = [
        "description.py",
        "real_description.py",
    ],
    deps = [
        ":pids",
        "//src/robot_model/rebot_arm_data:rs_mjcf",
        "//src/robot_model/rebot_arm_data:rs_visual_urdf",
        "//src/robot_model/robot_model_utils:ros2_control",
    ],
)

py_test(
    name = "description_test",
    size = "small",
    srcs = ["description_test.py"],
    # What RViz resolves the URDF's package:// mesh URIs through.
    data = [
        "@rebot_arm_description//:ament_index",
    ],
    deps = [
        ":description",
        "@rules_python//python/runfiles",
    ],
)

# ---- Kinematics (fast_robot_kinematics) ---------------------------------------

# rebot_arm_kinematics::make_kinematics: FK/IK of base_link -> gripper_end,
# generated at build time from the URDF of the RS MJCF (same frames as MuJoCo).
fast_kinematics(
    name = "rebot_arm_kinematics",
    namespace = "rebot_arm_kinematics",
    root_link = "base_link",
    tip_link = "gripper_end",
    urdf = "//src/robot_model/rebot_arm_data:rs_generated.urdf",
    visibility = ["//visibility:private"],
)

# Kinematics CLI: JSON FK / dense IK request on stdin -> answer on stdout
# (robot_model_utils/kinematics_cli.hpp). Used by //src/trajectory_generator for
# Cartesian moves.
cc_binary(
    name = "kinematics",
    srcs = ["kinematics_main.cpp"],
    deps = [
        ":rebot_arm",
        "//src/robot_model/robot_model_utils:kinematics_cli",
    ],
)

cc_test(
    name = "rebot_arm_kinematics_test",
    size = "small",
    srcs = ["rebot_arm_kinematics_test.cpp"],
    deps = [
        ":rebot_arm",
        "@rosdistro//cc:googletest",
    ],
)

# Inspect the model: bazel run //src/robot_model/rebot_arm:view  (MuJoCo viewer; see robot_model_utils/viewer.py)
model_viewer(
    name = "view",
    mjcf = "//src/robot_model/rebot_arm_data:rs_arm_mjcf",
)
