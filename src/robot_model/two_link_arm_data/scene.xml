<!-- two_link_arm: the single source of truth for the robot model.
     robot.urdf is generated from this file (//src/robot_model/mjcf_to_urdf). -->
<mujoco model="two_link_arm">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="2 2 0.1"/>
    <body name="base" pos="0 0 0.05">
      <geom type="cylinder" size="0.08 0.05" mass="5"/>
      <body name="link1" pos="0 0 0.05">
        <joint name="joint1" type="hinge" axis="0 0 1" damping="0.5" range="-3.14 3.14" actuatorfrcrange="-10 10"/>
        <geom type="capsule" fromto="0 0 0 0.4 0 0" size="0.03" mass="1"/>
        <body name="link2" pos="0.4 0 0">
          <joint name="joint2" type="hinge" axis="0 1 0" damping="0.5" range="-1.57 1.57" actuatorfrcrange="-10 10"/>
          <geom type="capsule" fromto="0 0 0 0.3 0 0" size="0.025" mass="0.5"/>
        </body>
      </body>
    </body>
  </worldbody>
  <contact>
    <!-- base is welded to the world, so MuJoCo doesn't filter its contacts with
         its child; link1 sits on top of it and would otherwise drag on joint1. -->
    <exclude body1="base" body2="link1"/>
  </contact>
  <actuator>
    <position name="joint1" joint="joint1" kp="100" kv="10"/>
    <position name="joint2" joint="joint2" kp="100" kv="10"/>
  </actuator>
</mujoco>
