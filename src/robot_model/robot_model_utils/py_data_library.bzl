"""py_data_library: give a data file (or executable) a Python interface.

    load("//src/robot_model/robot_model_utils:py_data_library.bzl", "py_data_library")

    py_data_library(name = "mjcf", src = "scene.xml")

    # in Python (module path follows the package, like any py_library):
    from src.robot_model.two_link_arm_data import mjcf
    mjcf.path()         # absolute path, resolved through runfiles
    mjcf.read_text()   # file contents
    mjcf.read_bytes()

If `src` is an executable target (cc_binary, py_binary, ...), the module also
has `popen(*args, **kwargs)` and `run(*args, **kwargs)`, thin wrappers around
subprocess with the executable as argv[0]; its runfiles come along as data.

To add helpers, pass `srcs = ["<name>.py"]`. The generated module is then
named `_<name>_data.py`; the hand-written `<name>.py` re-exports it and adds
methods on top:

    py_data_library(name = "ros2_control", src = "ros2_control.xml.j2", srcs = ["ros2_control.py"])

    # ros2_control.py
    from ._ros2_control_data import *  # path(), read_text(), read_bytes()
    def robot_description(...): ...

Either way `<pkg>.<name>` always provides path(), read_text() and read_bytes().

Private to the robot model packages (//src/robot_model/...); the prototype
simulation (//src/ros2_control_sim), //src/camera_drivers, //src/camera_models and
//src/trajectory_generator may load it too.
"""

load("@rules_python//python:defs.bzl", "py_library")

visibility([
    "//src/camera_drivers",
    "//src/camera_models/...",
    "//src/teleop/quest_bridge",
    "//src/teleop/quest_app/tools",
    "//src/robot_model/...",
    "//src/ros2_control_sim",
    "//src/trajectory_generator",
])

_FILE_TEMPLATE = '''"""Generated by py_data_library from {label}. Do not edit."""

import functools
import os

from python.runfiles import Runfiles

__all__ = ["LABEL", "RLOCATION", "path", "read_bytes", "read_text"{extra_all}]

LABEL = "{label}"
RLOCATION = "{rlocation}"


@functools.cache
def path() -> str:
    """Absolute path of {label}."""
    p = Runfiles.Create().Rlocation(RLOCATION)
    if not p or not os.path.exists(p):
        raise FileNotFoundError(f"{{LABEL}} not found in runfiles ({{RLOCATION}})")
    return p


def read_bytes() -> bytes:
    with open(path(), "rb") as f:
        return f.read()


def read_text(encoding: str = "utf-8") -> str:
    with open(path(), encoding=encoding) as f:
        return f.read()
'''

_EXECUTABLE_TEMPLATE = '''

def popen(*args, **kwargs):
    """subprocess.Popen([path(), *args], **kwargs)."""
    import subprocess

    return subprocess.Popen([path(), *map(str, args)], **kwargs)


def run(*args, **kwargs):
    """subprocess.run([path(), *args], **kwargs)."""
    import subprocess

    return subprocess.run([path(), *map(str, args)], **kwargs)
'''

def _rlocationpath(ctx, f):
    if f.short_path.startswith("../"):
        return f.short_path[3:]
    return ctx.workspace_name + "/" + f.short_path

def _py_data_module_impl(ctx):
    executable = ctx.attr.src[DefaultInfo].files_to_run.executable
    if executable:
        f = executable
    else:
        files = ctx.attr.src[DefaultInfo].files.to_list()
        if len(files) != 1:
            fail("{}: src must be a single file or an executable, got {} files".format(
                ctx.label,
                len(files),
            ))
        f = files[0]

    content = _FILE_TEMPLATE.format(
        label = str(ctx.attr.src.label),
        rlocation = _rlocationpath(ctx, f),
        extra_all = ', "popen", "run"' if executable else "",
    )
    if executable:
        content += _EXECUTABLE_TEMPLATE
    ctx.actions.write(ctx.outputs.out, content)
    return [DefaultInfo(files = depset([ctx.outputs.out]))]

_py_data_module = rule(
    implementation = _py_data_module_impl,
    attrs = {
        "out": attr.output(mandatory = True),
        "src": attr.label(mandatory = True, allow_files = True, cfg = "target"),
    },
)

def py_data_library(name, src, srcs = [], deps = [], data = [], **kwargs):
    """A py_library `<name>` whose module exposes `src` (see file docstring)."""
    if srcs and name + ".py" not in srcs:
        fail("{}: srcs must contain {}.py, the module that extends the generated one".format(name, name))
    generated = ("_{}_data.py" if srcs else "{}.py").format(name)
    _py_data_module(
        name = name + "_module",
        src = src,
        out = generated,
        visibility = ["//visibility:private"],
    )
    py_library(
        name = name,
        srcs = [generated] + srcs,
        data = [src] + data,
        deps = ["@rules_python//python/runfiles"] + deps,
        **kwargs
    )
