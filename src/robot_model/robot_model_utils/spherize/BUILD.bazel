# Collision spheres for VAMP: a hand-editable spec (spheres_spec.py) merged into
# a URDF (spherized_robot in spherize.bzl), plus a seeding tool.

load("@pip_ros//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//src/robot_model:__subpackages__"])

exports_files([
    "spherize.bzl",
    "export_spheres_obj.py",
    "import_spheres_obj.py",
])

py_library(
    name = "spheres_spec",
    srcs = ["spheres_spec.py"],
    deps = [
        requirement("numpy"),
        requirement("pyyaml"),
    ],
)

# The Blender round trip's code, for sphere_editor (spherize.bzl).
py_library(
    name = "sphere_editor_lib",
    srcs = [
        "export_spheres_obj.py",
        "import_spheres_obj.py",
        "prefix_spec.py",
    ],
    visibility = ["//src/robot_model:__subpackages__"],
    deps = [
        ":mjcf_collision",
        ":spheres_spec",
        requirement("numpy"),
    ],
)

py_library(
    name = "mjcf_collision",
    srcs = ["mjcf_collision.py"],
    deps = [requirement("numpy")],
)

# bazel run ...:export_spheres_obj -- --urdf <urdf> --spec <spec.yaml> --out <file.obj>
#     [--mjcf <mjcf>] [--config JOINT=POS ...]
py_binary(
    name = "export_spheres_obj",
    srcs = ["export_spheres_obj.py"],
    deps = [":sphere_editor_lib"],
)

# bazel run ...:import_spheres_obj -- --urdf <urdf> --spec <spec.yaml> --obj <edited.obj> [--out <spec.yaml>]
# The inverse of export_spheres_obj: the sphere_<link>_* objects of the OBJ edited in Blender replace the spec's spheres.
py_binary(
    name = "import_spheres_obj",
    srcs = ["import_spheres_obj.py"],
    deps = [":sphere_editor_lib"],
)

py_test(
    name = "import_spheres_obj_test",
    size = "small",
    srcs = ["import_spheres_obj_test.py"],
    deps = [
        ":sphere_editor_lib",
        requirement("numpy"),
    ],
)

# bazel run ...:prefix_spec -- --prefix left_ --spec a.yaml b.yaml --out left.yaml: a spec of one robot with
# prefixed names, for a model with several copies of it (rebot_dual_arm_gemini_305_data).
py_binary(
    name = "prefix_spec",
    srcs = ["prefix_spec.py"],
    deps = [":spheres_spec"],
)

py_test(
    name = "prefix_spec_test",
    size = "small",
    srcs = ["prefix_spec_test.py"],
    deps = [
        ":prefix_spec",
        ":spheres_spec",
    ],
)

py_binary(
    name = "spherize_urdf",
    srcs = ["spherize_urdf.py"],
    deps = [":spheres_spec"],
)

FOAM_TOOLS = {
    "makeTreeMedial": "@foam//:makeTreeMedial",
    "makeTreeGrid": "@foam//:makeTreeGrid",
    "makeTreeHubbard": "@foam//:makeTreeHubbard",
    "makeTreeOctree": "@foam//:makeTreeOctree",
    "makeTreeSpawn": "@foam//:makeTreeSpawn",
    "manifold": "@manifoldplus//:manifold",
    "simplify": "@fqms//:simplify",
    "manifold_old": "@manifold_old//:manifold_old",
    "simplify_old": "@manifold_old//:simplify_old",
}

# bazel run ...:seed_spheres -- --mjcf <file> --out <spec.yaml> [--method foam|kmeans|chain]
#     [--spheres N] [--max-triangles N] [--fix JOINT=POS ...] [--base-spec <spec.yaml>] [--save-meshes DIR]
py_binary(
    name = "seed_spheres",
    srcs = ["seed_spheres.py"],
    data = FOAM_TOOLS.values(),
    env = {"FOAM_RLOCATION_" + tool: "$(rlocationpath %s)" % label for tool, label in FOAM_TOOLS.items()},
    deps = [
        ":mjcf_collision",
        ":spheres_spec",
        "@foam",
        "@rules_python//python/runfiles",
        requirement("numpy"),
    ],
)

py_test(
    name = "spheres_spec_test",
    size = "small",
    srcs = ["spheres_spec_test.py"],
    deps = [":spheres_spec"],
)

# Rewrites one MJCF so its spherized bodies collide as the spec's spheres (spheres_mjcf in spherize.bzl).
py_binary(
    name = "spheres_mjcf",
    srcs = ["spheres_mjcf.py"],
    deps = [
        ":mjcf_collision",
        ":spheres_spec",
    ],
)

py_test(
    name = "spheres_mjcf_test",
    size = "small",
    srcs = ["spheres_mjcf_test.py"],
    deps = [":spheres_mjcf"],
)
