#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

# Simplified stand-in for the reBot Arm B601-RS: one Xform per MJCF body
# (rs_arm.xml), named after it, holding the body's world pose at the default
# configuration, with a box over each of the body's visual meshes (kept out of the wrist camera's
# view). Replace the boxes with the real
# assets; keep the body Xform names (rebot_arm_usd_test checks them against the MJCF).

