# Two reBot arms with a Gemini 305 each (the data is ../rebot_dual_arm_gemini_305_data): the
# ros2_control description of the simulation and of the real robot, and the model viewer.

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//src/robot_model/robot_model_utils:fast_kinematics.bzl", "fast_kinematics")
load("//src/robot_model/robot_model_utils:py_data_library.bzl", "py_data_library")
load("//src/robot_model/robot_model_utils:viewer.bzl", "model_viewer")

package(default_visibility = ["//visibility:public"])

# Position PID gains for the grippers' torque (<motor>) actuators (left_joint7, right_joint7).
py_data_library(
    name = "pids",
    src = "pids.yaml",
)

# Python: robot_description() for ros2_control (URDF + mujoco_ros2_control block), and
# real_robot_description() (URDF + one shared_can_ros2 block per arm).
py_library(
    name = "description",
    srcs = ["description.py"],
    deps = [
        ":pids",
        "//src/robot_model/rebot_arm:description",
        "//src/robot_model/rebot_dual_arm_gemini_305_data:mjcf",
        "//src/robot_model/rebot_dual_arm_gemini_305_data:visual_urdf",
        "//src/robot_model/robot_model_utils:ros2_control",
    ],
)

py_test(
    name = "description_test",
    size = "small",
    srcs = ["description_test.py"],
    # What RViz resolves the URDF's package:// mesh URIs through.
    data = [
        "@orbbec_description//:ament_index",
        "@rebot_arm_description//:ament_index",
    ],
    deps = [
        ":description",
        "@rules_python//python/runfiles",
    ],
)

# Inspect the model: bazel run //src/robot_model/rebot_dual_arm_gemini_305:view  (MuJoCo viewer)
model_viewer(
    name = "view",
    mjcf = "//src/robot_model/rebot_dual_arm_gemini_305_data:scene.xml",
    data = ["//src/robot_model/rebot_dual_arm_gemini_305_data:files"],
)

# ---- C++ -----------------------------------------------------------------------

# Each arm's FK/IK (fast_robot_kinematics): <prefix>base_link -> <prefix>gripper_end, generated at build time
# from the composed model's URDF (as for the single arm, rebot_arm_gemini_305).
[fast_kinematics(
    name = "rebot_dual_arm_%s_kinematics" % arm,
    namespace = "rebot_dual_arm_%s_kinematics" % arm,
    root_link = "%s_base_link" % arm,
    tip_link = "%s_gripper_end" % arm,
    urdf = "//src/robot_model/rebot_dual_arm_gemini_305_data:robot.urdf",
    visibility = ["//visibility:private"],
) for arm in ("left", "right")]

# rebot_dual_arm_gemini_305::load_mujoco_model, make_kinematics / make_kdl_kinematics (per arm).
cc_library(
    name = "rebot_dual_arm_gemini_305",
    srcs = ["rebot_dual_arm_gemini_305.cpp"],
    hdrs = ["rebot_dual_arm_gemini_305.hpp"],
    data = [
        "//src/robot_model/rebot_dual_arm_gemini_305_data:files",  # meshes and the camera model, next to scene.xml
        "//src/robot_model/rebot_dual_arm_gemini_305_data:scene.xml",
    ],
    includes = ["."],
    local_defines = [
        "REBOT_DUAL_ARM_GEMINI_305_MJCF=\\\"$(rlocationpath //src/robot_model/rebot_dual_arm_gemini_305_data:scene.xml)\\\"",
    ],
    deps = [
        ":rebot_dual_arm_left_kinematics",
        ":rebot_dual_arm_right_kinematics",
        "//src/robot_model/robot_model_utils:kdl_kinematics",
        "//src/robot_model/robot_model_utils:kinematics",
        "//src/robot_model/robot_model_utils:mujoco_model",
    ],
)

cc_test(
    name = "rebot_dual_arm_gemini_305_test",
    size = "small",
    srcs = ["rebot_dual_arm_gemini_305_test.cpp"],
    deps = [
        ":rebot_dual_arm_gemini_305",
        "@rosdistro//cc:googletest",
    ],
)
